# Copy to .env (ignored) or export these variables. Exported values take precedence.
# Use a read-only SQL Server login and a write-enabled PostgreSQL login.
MSSQL_DSN=sqlserver://<source-user>:<db-password>@<source-host>:1433?database=<source-db>&encrypt=true
PGSQL_DSN=postgres://<target-user>:<db-password>@<target-host>:5432/<target-db>?sslmode=require
